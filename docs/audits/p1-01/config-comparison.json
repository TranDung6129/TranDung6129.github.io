    "math": {
      "copytex": true,
      "enable": true,
      "katex": {
        "copytex": true,
        "errorcolor": "#ff4949",
        "macros": {}
      },
      "mathjax": {
        "cdn": "https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js",
        "loader": {
          "load": [
            "ui/safe"
          ],
          "paths": {}
        },
        "macros": {},
        "options": {
          "enablemenu": true
        },
        "packages": {}
      },
      "mhchem": true,
      "type": "mathjax"
    },
    "search": {
      "algolia": {},
      "contentlength": 4000,
      "enable": true,
      "fuse": {
        "distance": 100,
        "minmatchcharlength": 2,
        "threshold": 0.3
      },
      "highlighttag": "em",
      "maxresultlength": 10,
      "snippetlength": 30,
      "type": "fuse"
    },
    "markup": {
      "asciidocext": {
        "attributes": {},
        "backend": "html5",
        "failurelevel": "fatal",
        "noheaderorfooter": true,
        "safemode": "unsafe"
      },
      "defaultmarkdownhandler": "goldmark",
      "goldmark": {
        "extensions": {
          "cjk": {
            "eastasianlinebreaksstyle": "simple"
          },
          "definitionlist": true,
          "extras": {
            "delete": {
              "enable": true
            },
            "insert": {
              "enable": true
            },
            "mark": {
              "enable": true
            },
            "subscript": {
              "enable": true
            },
            "superscript": {
              "enable": true
            }
          },
          "footnote": true,
          "linkify": true,
          "linkifyprotocol": "https",
          "passthrough": {
            "delimiters": {
              "block": [
                [
                  "\\[",
                  "\\]"
                ],
                [
                  "$$",
                  "$$"
                ]
              ],
              "inline": [
                [
                  "\\(",
                  "\\)"
                ],
                [
                  "$",
                  "$"
                ]
              ]
            },
            "enable": true
          },
          "strikethrough": true,
          "table": true,
          "tasklist": true,
          "typographer": {
            "apostrophe": "&rsquo;",
            "ellipsis": "&hellip;",
            "emdash": "&mdash;",
            "endash": "&ndash;",
            "leftanglequote": "&laquo;",
            "leftdoublequote": "&ldquo;",
            "leftsinglequote": "&lsquo;",
            "rightanglequote": "&raquo;",
            "rightdoublequote": "&rdquo;",
            "rightsinglequote": "&rsquo;"
          }
        },
        "parser": {
          "attribute": {
            "block": true,
            "title": true
          },
          "autoheadingid": true,
          "autoidtype": "github",
          "wrapstandaloneimagewithinparagraph": true
        },
        "renderer": {
          "unsafe": true
        },
        "renderhooks": {
          "image": {
            "useembedded": "fallback"
          },
          "link": {
            "useembedded": "fallback"
          }
        }
      },
      "highlight": {
        "codefences": true,
        "guesssyntax": true,
        "linenos": true,
        "linenostart": 1,
        "linenumbersintable": true,
        "style": "monokai",
        "tabwidth": 4,
        "wrapperclass": "highlight"
      },
      "tableofcontents": {
        "endlevel": 6,
        "startlevel": 2
      }
    }
  },
